---
import type { GetStaticPaths } from 'astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import LinkRow from '../../components/LinkRow.astro'
import Pagination from '../../components/Pagination.astro'
import { CLIENT_NAMES, PAGE_POST_LIMIT } from '../../consts'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('technicalWriting')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  )

  return paginate(posts, { pageSize: PAGE_POST_LIMIT })
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<Layout
  title={
    page.currentPage === 1
      ? 'Technical Writing'
      : `Technical Writing - Page ${page.currentPage}`
  }
  description="All of the blog posts I've partnered with companies on. Want to work with me on a post for your company? Get in touch."
>
  <Header />

  <main class="mx-auto max-w-2xl space-y-12 px-6 py-20 sm:py-24">
    <div>
      <h1 class="text-4xl font-semibold tracking-tight text-light sm:text-5xl">
        Technical Writing
      </h1>
      <p class="mt-6 text-pretty text-mid sm:text-lg/8">
        Blog posts I've partnered with companies on. Want to work with me on a
        post for your company?{' '}
        <a href="mailto:hey@conermurphy.com" class="text-brand">
          Get in touch
        </a>
        .
      </p>
    </div>

    <ul>
      {page.data.map((post) => (
        <LinkRow
          title={post.data.title}
          href={post.data.url}
          meta={CLIENT_NAMES[post.data.client]}
          external
        />
      ))}
    </ul>

    <Pagination page={page} />
  </main>

  <Footer />
</Layout>
