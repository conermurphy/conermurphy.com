---
import Footer from '../components/Footer.astro'
import Layout from '../layouts/Layout.astro'
import { CLIENT_NAMES, SITE_DESCRIPTION, SITE_TITLE } from '../consts'
import { Image } from 'astro:assets'
import Logo from '../images/logo.svg'
import { getCollection } from 'astro:content'
import LinkRow from '../components/LinkRow.astro'
import Socials from '../components/Socials.astro'

const projects = await getCollection('projects')
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)
const techWritingPosts = (await getCollection('technicalWriting'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)
---

<Layout>
  <main class="mx-auto max-w-2xl space-y-20 px-6 py-24 sm:py-32">
    <div class="flex flex-col items-center text-center">
      <a href="/" class="-m-1.5 p-1.5">
        <span class="sr-only">{SITE_TITLE}</span>
        <Image class="h-10 w-auto" src={Logo} alt="" loading="eager" />
      </a>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-light sm:text-5xl">
        Coner Murphy
      </h1>
      <p class="mt-6 max-w-lg text-pretty text-mid sm:text-lg/8">
        {SITE_DESCRIPTION}
      </p>
      <div class="mt-8">
        <Socials />
      </div>
    </div>

    <section>
      <h2 class="font-code text-xs uppercase tracking-widest text-brand">
        // Blog
      </h2>
      <ul class="mt-4">
        {posts.map(({ data: post }) => (
          <LinkRow
            title={post.title}
            href={`/blog/${post.slug}/`}
            meta={post.date}
          />
        ))}
      </ul>
      <a href="/blog" class="mt-4 inline-block font-code text-sm text-brand">
        All posts →
      </a>
    </section>

    <section>
      <h2 class="font-code text-xs uppercase tracking-widest text-brand">
        // Technical Writing
      </h2>
      <ul class="mt-4">
        {techWritingPosts.map(({ data: post }) => (
          <LinkRow
            title={post.title}
            href={post.url}
            meta={CLIENT_NAMES[post.client]}
            external
          />
        ))}
      </ul>
      <a
        href="/technical-writing"
        class="mt-4 inline-block font-code text-sm text-brand"
      >
        All technical writing →
      </a>
    </section>

    <section>
      <h2 class="font-code text-xs uppercase tracking-widest text-brand">
        // Projects
      </h2>
      <ul class="mt-4">
        {projects.map(({ data: project }) => (
          <LinkRow title={project.name} href={project.url} external />
        ))}
      </ul>
    </section>
  </main>

  <Footer />
</Layout>
