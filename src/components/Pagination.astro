---
import type { Page } from 'astro'

interface Props {
  page: Page<unknown>
}

const { page } = Astro.props
---

<nav
  class="flex items-center justify-between font-code text-sm text-mid"
  aria-label="Pagination"
>
  <a
    href={page.url.prev}
    aria-disabled={!page.url.prev}
    class="text-brand aria-disabled:pointer-events-none aria-disabled:invisible"
  >
    ← Newer
  </a>
  <p>
    Page {page.currentPage} of {page.lastPage}
  </p>
  <a
    href={page.url.next}
    aria-disabled={!page.url.next}
    class="text-brand aria-disabled:pointer-events-none aria-disabled:invisible"
  >
    Older →
  </a>
</nav>
