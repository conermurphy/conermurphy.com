---
import HeaderLink from './HeaderLink.astro'
import { SITE_TITLE } from '../consts'
import { Image } from 'astro:assets'
import Logo from '../images/logo.svg'
---

<header class="mx-auto max-w-2xl px-6 pt-8">
  <nav class="flex items-center justify-between" aria-label="Global">
    <a href="/" class="-m-1.5 p-1.5">
      <span class="sr-only">{SITE_TITLE}</span>
      <Image class="h-6 w-auto" src={Logo} alt="" loading="eager" />
    </a>

    <div class="flex gap-x-6 font-code text-sm text-mid [&_.active]:text-light">
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/technical-writing">Technical Writing</HeaderLink>
    </div>
  </nav>
</header>
