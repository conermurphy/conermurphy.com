---
import type { CollectionEntry } from 'astro:content'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Layout from './Layout.astro'

type Props = CollectionEntry<'blog'>['data']

const { title, description, date, updatedDate, topics } = Astro.props
---

<Layout title={title} description={description} type="article" date={date}>
  <Header />

  <main class="py-20 sm:py-24">
    <article class="mx-auto max-w-3xl px-6">
      <div class="pb-12 sm:pb-16">
        <div class="flex flex-wrap items-center gap-x-2 font-code text-xs text-mid">
          <span class="text-brand">
            <FormattedDate date={date} />
          </span>
          {updatedDate ? (
            <span>
              · Updated <FormattedDate date={updatedDate} />
            </span>
          ) : null}
          {topics?.length ? (
            <span>· {topics.slice(0, 3).join(', ')}</span>
          ) : null}
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-light sm:text-4xl">
          {title}
        </h1>
        <p class="mt-6 text-pretty text-mid sm:text-lg/8">{description}</p>
      </div>
      <div class="text-light/90">
        <slot />
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<script>
  const links = document.querySelectorAll('a.linked-header')

  links.forEach((link) => {
    link.addEventListener('click', async () => {
      const newURL = `${window.location.origin}${window.location.pathname}#${link.id}`
      await navigator.clipboard.writeText(newURL)
    })
  })
</script>
