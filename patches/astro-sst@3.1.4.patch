+export declare function handler(event: APIGatewayProxyEventV2 | CloudFrontRequestEvent): Promise<string | void | import("aws-lambda").CloudFrontRequest | import("aws-lambda").APIGatewayProxyStructuredResultV2 | import("aws-lambda").APIGatewayProxyResult | import("aws-lambda").CloudFrontResultResponse | null>;
